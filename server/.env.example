PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/bhavishyat
ADMIN_PASSWORD=change-this-password
ADMIN_SECRET=change-this-to-a-long-random-string
DELETE_PASSWORD=bhavishyat-delete
# Leave empty in local development. Set this on Hostinger so share previews use the public site.
# PUBLIC_ORIGIN=https://bhavishyat.in

# --- WhatsApp AI assistant (/admin/workflow). Every block is optional: empty = demo mode. ---
# Meta WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings > Basic > App secret (used to verify X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Any long random string; paste the same value in Meta's webhook "Verify token" field
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
# Approved utility template with one body variable {{1}}; used when a message falls outside
# WhatsApp's 24-hour customer window (late payment confirmations, team alerts)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Any OpenAI-compatible chat/completions provider
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional cheaper model for intent classification (defaults to LLM_MODEL)
LLM_CLASSIFIER_MODEL=

# Razorpay (Dashboard > Account & Settings > API keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Team alerts on handoff and paid bookings
# Comma-separated WhatsApp numbers with country code, e.g. 919180281884
TEAM_WHATSAPP_NUMBERS=
# Slack or Discord incoming webhook URL
TEAM_WEBHOOK_URL=

PRICE_PERSONAL_INR=5100
PRICE_SIGNATURE_INR=8100
PRICE_ADDITIONAL_INR=3100
ASSISTANT_BRAND_NAME=BHAVISHYAT
ASSISTANT_ASTROLOGER_NAME=B S Shubhram
ASSISTANT_CONTACT_EMAIL=connect@bhavishyat.in
ASSISTANT_HISTORY_LIMIT=12
# ASSISTANT_DEBUG=true
